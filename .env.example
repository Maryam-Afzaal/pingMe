# PingMe Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# External Job/Opportunity APIs
# ============================================================

# RapidAPI Key (for JSearch, LinkedIn Jobs, and other job APIs)
# Get yours at: https://rapidapi.com
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key_here

# Adzuna API (free tier available - job listings worldwide)
# Register at: https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Devpost API (for hackathons)
# https://devpost.com/api
DEVPOST_API_KEY=your_devpost_key_here

# EmailJS (for newsletter signups without backend)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ============================================================
# Database (optional - for saving user preferences)
# ============================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/pingme

# ============================================================
# Analytics (optional)
# ============================================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
